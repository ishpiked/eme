BOT_TOKEN=123456:ABC-your-token-from-BotFather
BOT_OWNER_ID=123456789
MAX_DURATION_SEC=600
MAX_FILE_MB=49
MP3_QUALITY=320
# Optional TypeTube API endpoint; the default is the official hosted API.
TYPETUBE_ENDPOINT=https://typetube.xysushi.in
# Optional storage overrides. By default credentials and bot-state.sqlite3 are
# stored under the OS user config directory, outside the project folder.
# BOT_DATA_DIR=
# TYPETUBE_KEY_FILE=
# BOT_DATABASE_FILE=
# Tip: set PYTHONDONTWRITEBYTECODE=1 in your environment so Python never
# writes __pycache__ / *.pyc files.